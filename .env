# Public settings for RECALL. Safe to commit: these values end up inside the public
# website anyway, and your data is protected by Supabase's row-level security, not by them.
# Never put the Supabase "secret" / "service_role" key or the database password here.
# (Real secrets would go in .env.local, which git ignores.)

# The site lives at https://<github-user>.github.io/recall — change if you rename the repo.
NEXT_PUBLIC_BASE_PATH=/recall

# Supabase → Connect (or Project Settings → Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
